{
  "name": "@pullbase/api",
  "version": "1.0.0",
  "description": "REST API server powering PullBase — Express 5, PostgreSQL, Drizzle ORM, IPFS/Pinata, OpenAI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch ./dist/index.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "npx tsx src/seed.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "openai": "^6.27.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76",
    "drizzle-zod": "^0.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "4.21.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "PullBase Team <dev@pullbase.net>",
  "license": "MIT",
  "homepage": "https://pullbase.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/pullbase-dev/pullbase-api.git"
  },
  "bugs": {
    "url": "https://github.com/pullbase-dev/pullbase-api/issues"
  }
}
