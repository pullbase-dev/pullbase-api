# PullBase API — Environment Variables
# Copy to .env and fill in values

# HTTP port (required)
PORT=8080

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/pullbase

# Pinata JWT for IPFS pinning (required)
# Get one at https://app.pinata.cloud/keys
PINATA_JWT=

# OpenAI API key (required for AI agents + model card generation)
OPENAI_API_KEY=

# Optional: custom OpenAI base URL (for Azure, local models, etc.)
# OPENAI_BASE_URL=
